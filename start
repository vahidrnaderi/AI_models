#!/usr/bin/env bash
set -euo pipefail
cd "${HOME:-/home/jovyan}"

# Binder has no GPU; avoid CUDA init and limit thread memory use.
export CUDA_VISIBLE_DEVICES=""
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2

# Use jupyterhub-singleuser so Binder's /api health check passes quickly.
# Voilà opens via ServerApp.default_url in etc/jupyter/.../voila.json.
exec jupyterhub-singleuser
